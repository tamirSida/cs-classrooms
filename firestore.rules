rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthed() && userDoc().role == 'super_admin';
    }

    function isAdmin() {
      return isAuthed() && userDoc().role in ['admin', 'super_admin'];
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // First-run settings may only hold defaults, so whoever creates the doc
    // cannot switch on a permission or loosen signup.
    function hasDefaultSettingsOnly() {
      let d = request.resource.data;
      return d.get('allowRecurringForAllUsers', false) == false
        && d.get('adminCanOverrideBookings', false) == false
        && d.get('restrictSignupDomain', true) == true
        && d.get('allowedSignupDomains', ['runi.ac.il']) == ['runi.ac.il']
        && d.get('defaultMaxTimePerDay', 60) == 60
        && d.get('operatingHours', {'start': '08:00', 'end': '18:00'}) == {'start': '08:00', 'end': '18:00'}
        && d.get('timeSlotDuration', 15) == 15
        && d.get('requiresApproval', false) == false
        && !('signupCode' in d);
    }

    // ─── users ──────────────────────────────────────────────────────
    // Reads open to any authed user. Creates/deletes only via admin SDK
    // (API routes). Super admins edit anything; admins only manage classroom
    // assignments; users only rename themselves. Email, role and isActive are
    // never self-editable because the server trusts them.
    match /users/{uid} {
      allow read: if isAuthed();
      allow create, delete: if false;
      allow update: if isSuperAdmin()
        || (isAdmin() && changesOnly(['assignedClassrooms', 'updatedAt']))
        || (isAuthed() && request.auth.uid == uid && changesOnly(['displayName', 'updatedAt']));
    }

    // ─── classrooms ─────────────────────────────────────────────────
    // Reads open. Updates for admins only. Create/delete go through API routes.
    match /classrooms/{id} {
      allow read: if isAuthed();
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    // ─── bookings ───────────────────────────────────────────────────
    // Reads open. All writes go through API routes, which check identity,
    // conflicts and approval.
    match /bookings/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ─── bookingSeries ──────────────────────────────────────────────
    // Written only by API routes (admin SDK).
    match /bookingSeries/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ─── settings ───────────────────────────────────────────────────
    // /settings page writes via client SDK (super admins only). Any signed-in
    // user may create the global doc on first run, with defaults only
    // (matches getOrCreateGlobalSettings).
    match /settings/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && id == 'global'
        && !exists(/databases/$(database)/documents/settings/$(id))
        && hasDefaultSettingsOnly();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ─── invitations ────────────────────────────────────────────────
    // Tokens are sensitive; client never touches them. API-only.
    match /invitations/{token} {
      allow read, write: if false;
    }
  }
}
