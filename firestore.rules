rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthed() && userDoc().role == 'super_admin';
    }

    function isAdmin() {
      return isAuthed() && userDoc().role in ['admin', 'super_admin'];
    }

    // True when an update changes the `role` field.
    function roleChanged() {
      return request.resource.data.role != resource.data.role;
    }

    // True when an update changes the `isActive` field.
    function activeChanged() {
      return request.resource.data.get('isActive', null) != resource.data.get('isActive', null);
    }

    function isSeriesBooking(data) {
      return 'seriesId' in data || 'occurrenceIndex' in data;
    }

    // First-run settings may only hold defaults, so whoever creates the doc
    // cannot switch on a permission or loosen signup.
    function hasDefaultSettingsOnly() {
      let d = request.resource.data;
      return d.get('allowRecurringForAllUsers', false) == false
        && d.get('adminCanOverrideBookings', false) == false
        && d.get('restrictSignupDomain', true) == true
        && d.get('allowedSignupDomains', ['runi.ac.il']) == ['runi.ac.il']
        && d.get('defaultMaxTimePerDay', 60) == 60
        && !('signupCode' in d);
    }

    // ─── users ──────────────────────────────────────────────────────
    // Reads open to any authed user. Creates/deletes only via admin SDK
    // (API routes). Updates open EXCEPT changing `role` or `isActive`, which
    // must be performed by a super_admin.
    match /users/{uid} {
      allow read: if isAuthed();
      allow create, delete: if false;
      allow update: if isAuthed() && ((!roleChanged() && !activeChanged()) || isSuperAdmin());
    }

    // ─── classrooms ─────────────────────────────────────────────────
    // Reads open. Updates for admins only. Create/delete go through API routes.
    match /classrooms/{id} {
      allow read: if isAuthed();
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    // ─── bookings ───────────────────────────────────────────────────
    // Reads open. Create + delete go via API routes. Client updates stay
    // open for single bookings (older clients approve this way) but never
    // touch recurring-series bookings, which change only via API routes.
    match /bookings/{id} {
      allow read: if isAuthed();
      allow create, delete: if false;
      allow update: if isAuthed()
        && !isSeriesBooking(resource.data)
        && !isSeriesBooking(request.resource.data);
    }

    // ─── bookingSeries ──────────────────────────────────────────────
    // Written only by API routes (admin SDK).
    match /bookingSeries/{id} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ─── settings ───────────────────────────────────────────────────
    // /settings page writes via client SDK (super admins only). Any signed-in
    // user may create the global doc on first run, with defaults only
    // (matches getOrCreateGlobalSettings).
    match /settings/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && id == 'global'
        && !exists(/databases/$(database)/documents/settings/$(id))
        && hasDefaultSettingsOnly();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ─── invitations ────────────────────────────────────────────────
    // Tokens are sensitive; client never touches them. API-only.
    match /invitations/{token} {
      allow read, write: if false;
    }
  }
}
